# Application
NODE_ENV=development
PORT=3000
APP_NAME=NotificationHub
APP_VERSION=1.0.0
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://notification_hub:notification_hub@localhost:5432/notification_hub

# Redis & Queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=replace_with_at_least_32_random_characters
CHANNEL_CONFIG_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
JWT_EXPIRATION=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Delivery HTTP Safety
DELIVERY_HTTP_TIMEOUT_MS=5000
DELIVERY_HTTP_MAX_RESPONSE_BYTES=32768
DELIVERY_HTTP_BLOCK_PRIVATE_NETWORKS=true
DELIVERY_OUTBOX_INTERVAL_MS=30000
