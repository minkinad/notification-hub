// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      Role     @default(USER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects          Project[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  assignedWorkItems WorkItem[]        @relation("WorkItemAssignee")
  reportedWorkItems WorkItem[]        @relation("WorkItemReporter")
  workItemComments  WorkItemComment[]
  workViews         WorkView[]

  @@map("users")
}

model Project {
  id              String   @id @default(cuid())
  name            String
  description     String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyHash      String   @unique @map("api_key_hash")
  apiKeyPrefix    String   @map("api_key_prefix")
  rateLimit       Int      @default(1000)
  rateLimitWindow Int      @default(3600)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events        Event[]
  notifications Notification[]
  channels      NotificationChannel[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  workCycles    WorkCycle[]
  workModules   WorkModule[]
  workItems     WorkItem[]
  workViews     WorkView[]

  @@index([userId])
  @@map("projects")
}

model ApiKey {
  id              String    @id @default(cuid())
  keyHash         String    @unique @map("key_hash")
  keyPrefix       String    @map("key_prefix")
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  scopes          Json      @default("[]")
  rateLimit       Int?
  rateLimitWindow Int?
  active          Boolean   @default(true)
  lastUsed        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?

  @@unique([projectId, name])
  @@index([userId])
  @@index([projectId])
  @@map("api_keys")
}

model Event {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  data      Json
  status    EventStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  notifications Notification[]

  @@index([projectId])
  @@index([type])
  @@index([status])
  @@map("events")
}

model NotificationChannel {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      ChannelType
  config    Json
  name      String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  notifications Notification[]

  @@unique([projectId, type])
  @@index([projectId])
  @@map("notification_channels")
}

model Notification {
  id           String              @id @default(cuid())
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channelId    String
  channel      NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  recipient    String
  subject      String?
  template     String
  templateData Json                @default("{}")
  status       NotificationStatus  @default(PENDING)
  retryCount   Int                 @default(0)
  maxRetries   Int                 @default(3)
  nextRetryAt  DateTime?
  lastError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sentAt       DateTime?

  deliveryLogs   DeliveryLog[]
  deliveryOutbox DeliveryOutbox?

  @@index([projectId])
  @@index([eventId])
  @@index([channelId])
  @@index([status])
  @@index([recipient])
  @@map("notifications")
}

model DeliveryOutbox {
  id             String       @id @default(cuid())
  notificationId String       @unique
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attempts       Int          @default(0)
  lastError      String?
  nextAttemptAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([nextAttemptAt])
  @@map("delivery_outbox")
}

model DeliveryLog {
  id             String         @id @default(cuid())
  notificationId String
  notification   Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         DeliveryStatus
  statusCode     Int?
  response       Json?
  error          String?
  attemptedAt    DateTime       @default(now())
  createdAt      DateTime       @default(now())

  @@index([notificationId])
  @@index([status])
  @@map("delivery_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   Json?
  changes   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([action])
  @@map("audit_logs")
}

model WorkCycle {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      WorkCycleStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workItems WorkItem[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([status])
  @@map("work_cycles")
}

model WorkModule {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      WorkModuleStatus @default(PLANNED)
  targetDate  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workItems WorkItem[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([status])
  @@map("work_modules")
}

model WorkItem {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence    Int
  title       String
  description String?
  status      WorkItemStatus   @default(BACKLOG)
  priority    WorkItemPriority @default(NONE)
  labels      Json             @default("[]")
  estimate    Int?
  dueDate     DateTime?
  sortOrder   Float            @default(0)
  cycleId     String?
  cycle       WorkCycle?       @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  moduleId    String?
  module      WorkModule?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?            @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId  String?
  reporter    User?            @relation("WorkItemReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?

  comments WorkItemComment[]

  @@unique([projectId, sequence])
  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([cycleId])
  @@index([moduleId])
  @@index([assigneeId])
  @@map("work_items")
}

model WorkItemComment {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workItemId])
  @@index([authorId])
  @@map("work_item_comments")
}

model WorkView {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  layout      WorkViewLayout @default(KANBAN)
  filters     Json           @default("{}")
  shared      Boolean        @default(false)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([createdById])
  @@map("work_views")
}

enum Role {
  ADMIN
  USER
  VIEWER
}

enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ChannelType {
  EMAIL
  TELEGRAM
  WEBHOOK
  SMS
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  RETRYING
}

enum DeliveryStatus {
  SUCCESS
  FAILED
  PENDING
  RETRYING
}

enum WorkCycleStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

enum WorkModuleStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

enum WorkItemStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

enum WorkItemPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkViewLayout {
  KANBAN
  LIST
  CALENDAR
  GANTT
}
